@page "/"
@using System.Collections.Generic
@using System.Linq
@using System.Net.Http.Json
@using CryptoBot.Application.Common.Interfaces
@using CryptoBot.Application.Realtime
@using CryptoBot.ConsoleApp.Api.Dtos
@using CryptoBot.ConsoleApp.Components.Dashboard
@using CryptoBot.ConsoleApp.Realtime
@using CryptoBot.ConsoleApp.Services
@using CryptoBot.Domain.Enums
@using CryptoBot.Domain.Repositories
@inject IServiceScopeFactory ScopeFactory
@inject DashboardEventBus Bus
@inject IExchangeCredentialProvider Credentials
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject ILogger<Dashboard> Logger
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>CryptoBot · Dashboard</PageTitle>

@if (_showKillSwitchConfirm)
{
    <div class="env-modal-backdrop">
        <div class="env-modal" role="dialog" aria-modal="true">
            <div class="env-modal-header">
                <span class="env-modal-icon">🚨</span>
                <h3>確認執行緊急停機？</h3>
            </div>
            <div class="env-modal-body">
                <p class="env-modal-warn-line">
                    此動作將立即：
                </p>
                <ul class="env-modal-bullets">
                    <li><b>撤銷所有</b>尚未成交的委託單。</li>
                    <li>以<b>市價平倉</b>所有目前開倉中的部位。</li>
                    <li>停止所有正在執行的策略。</li>
                </ul>
                <p class="env-modal-warn-line">
                    不可逆。建議僅在系統失控或市場劇烈波動時使用。
                </p>
            </div>
            <div class="env-modal-actions">
                <button type="button" class="env-modal-btn env-modal-btn-cancel"
                        disabled="@_killSwitchBusy" @onclick="CancelKillSwitch">
                    取消
                </button>
                <button type="button" class="env-modal-btn env-modal-btn-danger"
                        disabled="@_killSwitchBusy" @onclick="ConfirmKillSwitchAsync">
                    @(_killSwitchBusy ? "執行中…" : "確認執行 KILL SWITCH")
                </button>
            </div>
        </div>
    </div>
}

@if (_showKeyModal)
{
    <div class="env-modal-backdrop">
        <div class="env-modal" role="dialog" aria-modal="true">
            <div class="env-modal-header">
                <span class="env-modal-icon">🔑</span>
                <h3>尚未設定 BingX API 金鑰</h3>
            </div>
            <div class="env-modal-body">
                <p class="env-modal-warn-line">
                    系統目前沒有任何啟用中的交易所金鑰。在設定前指揮中心無法查詢餘額或下單。
                </p>
                <ul class="env-modal-bullets">
                    <li>請到 <b>Settings · 金鑰</b> 頁面新增一組 API Key / Secret。</li>
                    <li>金鑰以 SQLite 本地儲存 — <b>切勿</b> 把 cryptobot.db 傳到公開環境。</li>
                    <li>切換 / 刪除會即時重建 SDK client，不需重啟服務。</li>
                </ul>
            </div>
            <div class="env-modal-actions">
                <button type="button" class="env-modal-btn env-modal-btn-cancel" @onclick="DismissKeyModal">
                    稍後再設定
                </button>
                <button type="button" class="env-modal-btn env-modal-btn-danger" @onclick="GoToKeySettings">
                    前往金鑰設定
                </button>
            </div>
        </div>
    </div>
}

@if (_breaker?.IsTripped == true)
{
    <div class="breaker-banner" role="alert">
        <span class="breaker-banner-icon">🟣</span>
        <div>
            <div class="breaker-banner-title">日損熔斷已觸發</div>
            <div>原因：@(_breaker.Reason ?? "—")　·　觸發時間：@(_breaker.TrippedAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</div>
            <div class="panel-sub">熔斷期間所有策略自動停止，啟動按鈕被鎖定。跨 UTC 日自動解除，或由管理員按下 Reset 手動解除。</div>
        </div>
        <button type="button" class="breaker-banner-reset"
                disabled="@_breakerBusy" @onclick="OnResetBreakerAsync">
            @(_breakerBusy ? "執行中…" : "Reset 熔斷")
        </button>
    </div>
}

<div class="kill-switch-bar">
    <button type="button" class="kill-switch-btn" @onclick="OnKillSwitchClick">
        🚨 EMERGENCY KILL SWITCH
    </button>
</div>

@* S44：戰情室左右分欄 —
   LEFT（350px）：策略控制台（Active Strategy card + 心跳燈）
   RIGHT（1fr）：上半 決策動態日誌；下半 交易歷史表
   外層 grid 由 .war-room-grid 控，視口 < 900px 會自動回退成單欄堆疊。 *@
<div class="war-room-grid">
<aside class="war-room-left">
<section class="panel">
    <header class="panel-header">
        <h2>策略控制台</h2>
        <span class="panel-sub">S25 · 策略大腦與執行狀態即時切換</span>
    </header>
    @if (_primaryStrategy is null)
    {
        <div class="empty">尚未建立任何策略 — 請先從 seed 或 /lab 新增。</div>
    }
    else
    {
        <div class="control-row">
            <div class="control-cell">
                <label class="control-label">Strategy</label>
                <div class="control-value">
                    <strong>@_primaryStrategy.Name</strong>
                    <span class="panel-sub">@_primaryStrategy.Symbol · @_primaryStrategy.Interval</span>
                    @* S36-S38 T1：把策略背後的「決策大腦」用業界術語 + 色碼 badge 標出來 —
                       使用者在 Dashboard 一眼就知道當前跑的是 SMA Crossover 還是 Bollinger Reversion，
                       不用靠策略名稱（可能被使用者自訂成 "SMA-Test"）去猜背後的模型。*@
                    <span class="model-tag @ModelTagClass(_primaryStrategy.StrategyType)"
                          title="@ModelTooltip(_primaryStrategy.StrategyType)">
                        Model: @ModelDisplayName(_primaryStrategy.StrategyType)
                    </span>
                </div>
            </div>

            <div class="control-cell">
                <label class="control-label">決策大腦</label>
                @* S56 T2 終極方案：原生 select 的 popup 吃不到深色 CSS，換成自製 GlassDropdown。 *@
                <GlassDropdown TValue="string"
                               Value="@_selectedStrategyType"
                               ValueChanged="@OnStrategyTypeSelectedAsync"
                               Items="@_availableTypes"
                               Disabled="@(_ctrlBusy || _availableTypes.Count == 0)" />
            </div>

            <div class="control-cell">
                <label class="control-label">執行狀態</label>
                <label class="toggle-switch">
                    <input type="checkbox"
                           disabled="@(_ctrlBusy || _breaker?.IsTripped == true)"
                           checked="@(_primaryStrategy.Status == "Running")"
                           @onchange="OnToggleRunningAsync" />
                    <span class="toggle-slider"></span>
                    <span class="toggle-text @(_primaryStrategy.Status == "Running" ? "pos" : "neg")">
                        @(_primaryStrategy.Status == "Running" ? "Running" : _primaryStrategy.Status)
                    </span>
                </label>
                @* S42：執行中才秀呼吸燈；Running 的最終視覺證明 — 評估事件進來時
                   `_heartbeatPulseTick` 會變動，觸發 CSS :key 屬性重播 1 秒亮綠閃爍動畫。 *@
                @if (_primaryStrategy.Status == "Running")
                {
                    <span class="heartbeat-dot" @key="_heartbeatPulseTick" title="策略大腦持續運行中"></span>
                }
                @if (_breaker?.IsTripped == true)
                {
                    <span class="panel-sub" style="color:#c8a4e0;">🔒 鎖定中（熔斷）</span>
                }
            </div>
        </div>

        @* S42 T1/T2：心跳標籤 — 時間戳 + 距今秒數。「從未評估」提示使用者策略剛啟動還沒跑到第一根 K 線。 *@
        <div class="heartbeat-row">
            <span class="panel-sub">Last Evaluated:</span>
            @if (_primaryStrategy.LastEvaluatedAtUtc is DateTime last)
            {
                <span class="heartbeat-time">[@last.ToLocalTime().ToString("HH:mm:ss")]</span>
                <span class="panel-sub">(@FormatAgo(_nowUtc - last))</span>
            }
            else
            {
                <span class="panel-sub">（尚未產生第一次評估 — 等待下一根收盤 K 線）</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(_ctrlInfo))
        {
            <div class="settings-info">@_ctrlInfo</div>
        }
        @if (!string.IsNullOrEmpty(_ctrlError))
        {
            <div class="settings-error">@_ctrlError</div>
        }
    }
</section>
</aside>

<main class="war-room-right">

@* S44 T1：滾動決策日誌 — LinkedList 滿 30 筆就從尾端移除最舊的一筆。
   最新的一筆位於頂端（CSS 用 column-reverse flex，保留 _evaluationLog 的 AddFirst 語義）。 *@
<section class="panel eval-log-panel">
    <header class="panel-header">
        <h2>決策動態日誌</h2>
        <span class="panel-sub">S44 · 最多 @EvaluationLogCapacity 筆 · 最新顯示在最上方</span>
    </header>
    @if (_evaluationLog.Count == 0)
    {
        <div class="empty">等待第一筆決策 — 策略啟動後的評估事件會即時流入。</div>
    }
    else
    {
        <ol class="eval-log">
            @foreach (var e in _evaluationLog)
            {
                <li class="eval-log-entry @e.CssClass">
                    <span class="eval-log-time">[@e.TimestampLocal.ToString("HH:mm:ss")]</span>
                    <span class="eval-log-tag">@e.Tag</span>
                    <span class="eval-log-body">
                        <strong>@e.StrategyName</strong> · @e.Symbol
                        @if (!string.IsNullOrEmpty(e.Note))
                        {
                            <span class="eval-log-note">— @e.Note</span>
                        }
                    </span>
                </li>
            }
        </ol>
    }
</section>

@* S39：完整交易歷史 + AI 複盤 Prompt 產生器 — S44 移入戰情室右下。 *@
<TradeHistoryTable Limit="50" />

</main>
</div>

<section class="grid-cards">
    <article class="card">
        <span class="card-label">Total Equity (USDT)</span>
        <span class="card-value @(_stats is null ? "" : _stats.TotalEquity >= 0 ? "pos" : "neg")">
            @FormatMoney(_stats?.TotalEquity)
        </span>
        <span class="card-footnote">Balance + Unrealized</span>
    </article>

    <article class="card">
        <span class="card-label">Today P&amp;L</span>
        <span class="card-value @(_stats is null ? "" : _stats.TodayPnL >= 0 ? "pos" : "neg")">
            @FormatSignedMoney(_stats?.TodayPnL)
        </span>
        <span class="card-footnote">Realized + Unrealized since UTC 00:00</span>
    </article>

    <article class="card">
        <span class="card-label">Active Strategies</span>
        <span class="card-value">
            @(_stats?.ActiveStrategyCount.ToString() ?? "—")
        </span>
        <span class="card-footnote">Status = Running</span>
    </article>
</section>

<section class="panel">
    <header class="panel-header">
        <h2>Active Positions</h2>
        <span class="panel-sub">@(_openPositions.Count) open</span>
    </header>

    @if (_openPositions.Count == 0)
    {
        <div class="empty">No open positions — bot is flat.</div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Symbol</th>
                    <th>Side</th>
                    <th>Qty</th>
                    <th>Entry</th>
                    <th>Mark</th>
                    <th>uPnL</th>
                    <th>uPnL %</th>
                    <th>Opened</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _openPositions)
                {
                    <tr>
                        <td>@p.Symbol</td>
                        <td class="@(p.Side == "Long" ? "pos" : "neg")">@p.Side</td>
                        <td>@p.Quantity.ToString("N4")</td>
                        <td>@p.EntryPrice.ToString("N2")</td>
                        <td>@(p.CurrentPrice?.ToString("N2") ?? "—")</td>
                        <td class="@(p.UnrealizedPnL >= 0 ? "pos" : "neg")">@p.UnrealizedPnL.ToString("N4")</td>
                        <td class="@(p.UnrealizedPnLPercent >= 0 ? "pos" : "neg")">@p.UnrealizedPnLPercent.ToString("N2")%</td>
                        <td>@p.OpenedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="panel">
    <header class="panel-header">
        <h2>Recent Trades</h2>
        <span class="panel-sub">last 10</span>
    </header>

    @if (_recentTrades.Count == 0)
    {
        <div class="empty">No trades yet — waiting for the first signal.</div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Symbol</th>
                    <th>Side</th>
                    <th>Qty</th>
                    <th>Avg Fill</th>
                    <th>Status</th>
                    <th>Reason</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in _recentTrades)
                {
                    var isRejected = string.Equals(t.Status, "Rejected", StringComparison.OrdinalIgnoreCase);
                    <tr>
                        <td>@t.CreatedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                        <td>@t.Symbol</td>
                        <td class="@(t.Side == "Buy" ? "pos" : "neg")">@t.Side @t.PositionSide</td>
                        <td>@t.Quantity.ToString("N4")</td>
                        <td>@(t.AverageFillPrice?.ToString("N2") ?? "—")</td>
                        <td class="@(isRejected ? "neg" : null)">@t.Status</td>
                        <td title="@(t.RejectReason ?? string.Empty)" style="max-width:320px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;@(isRejected ? "color:var(--neg,#d64545);" : string.Empty)">
                            @(string.IsNullOrWhiteSpace(t.RejectReason) ? "—" : t.RejectReason)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private DashboardStatsUpdate? _stats;
    private List<OpenPositionDto> _openPositions = new();
    private List<RecentTradeDto> _recentTrades = new();

    private Action<DashboardStatsUpdate>? _statsHandler;
    private Action<TradeFilledUpdate>? _tradeHandler;
    private EventHandler<ExchangeCredentialsChangedEventArgs>? _credsHandler;

    // S42：心跳事件訂閱 + 「Ns ago」秒針計時器。
    // _heartbeatPulseTick 每次遞增都會讓 heartbeat-dot 的 @key 變 — Blazor 重建 DOM 節點 → CSS 動畫重播。
    private Action<StrategyEvaluatedUpdate>? _heartbeatHandler;
    private Action<PositionPnLTickUpdate>? _pnlTickHandler;
    private int _heartbeatPulseTick;
    private DateTime _nowUtc = DateTime.UtcNow;
    private System.Timers.Timer? _agoTicker;

    // S44 T1：滾動決策日誌 — LinkedList 做固定容量的 ring buffer。
    // 每次新事件 AddFirst（最新在頂），Count > Capacity 時 RemoveLast 把最舊的一筆丟掉。
    // UI 直接遍歷 _evaluationLog 即可得到最新 → 最舊的顯示順序。
    private const int EvaluationLogCapacity = 30;
    private readonly LinkedList<EvaluationEntry> _evaluationLog = new();
    private Action<StrategyEvaluationFailedUpdate>? _evalFailedHandler;
    private Action<StrategyMetadataChangedUpdate>? _metadataChangedHandler;

    /// <summary>
    /// Dashboard 決策日誌的一筆紀錄 — UI 專屬型別，不與 Application 層 event record 混用。
    /// <c>CssClass</c> 驅動 INF/SIGNAL/ERROR 色碼。
    /// </summary>
    private sealed record EvaluationEntry(
        DateTime TimestampLocal,
        string Tag,           // "INF" / "SIGNAL BUY" / "SIGNAL SELL" / "ERROR"
        string CssClass,      // "inf" / "signal-buy" / "signal-sell" / "error"
        string StrategyName,
        string Symbol,
        string? Note);

    // S25 controls
    private StrategyDto? _primaryStrategy;
    private string _selectedStrategyType = string.Empty;
    private List<string> _availableTypes = new();
    private bool _ctrlBusy;
    private string? _ctrlInfo;
    private string? _ctrlError;

    // S24 onboarding
    private bool _showKeyModal;
    private bool _keyModalDismissed;

    // S28 Safety Breaker + Kill Switch
    private BreakerStatusDto? _breaker;
    private bool _breakerBusy;
    private bool _showKillSwitchConfirm;
    private bool _killSwitchBusy;
    private Action<BreakerStateUpdate>? _breakerHandler;

    private HttpClient CreateClient()
    {
        var http = HttpFactory.CreateClient();
        http.BaseAddress = new Uri(Nav.BaseUri);
        return http;
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshKeyGateAsync();
        _credsHandler = OnCredentialsChanged;
        Credentials.CredentialsChanged += _credsHandler;

        // 1) 首屏快照（不等 2s 心跳）
        await RefreshSnapshotAsync();
        await LoadStrategyControlsAsync();
        await LoadBreakerStatusAsync();

        // 2) 訂閱即時推播 — 後續只差異更新，不再整包重拉
        _statsHandler = OnStatsUpdate;
        _tradeHandler = OnTradeFilled;
        _breakerHandler = OnBreakerChanged;
        _heartbeatHandler = OnStrategyEvaluated;
        _pnlTickHandler = OnPositionPnLTicked;
        _evalFailedHandler = OnStrategyEvaluationFailed;
        _metadataChangedHandler = OnStrategyMetadataChanged;
        Bus.StatsUpdated += _statsHandler;
        Bus.TradeFilled += _tradeHandler;
        Bus.BreakerStateChanged += _breakerHandler;
        Bus.StrategyEvaluated += _heartbeatHandler;
        Bus.PositionPnLTicked += _pnlTickHandler;
        Bus.StrategyEvaluationFailed += _evalFailedHandler;
        Bus.StrategyMetadataChanged += _metadataChangedHandler;

        // S42：1 秒心跳讓「(Ns ago)」自增 — 沒新事件也能看到時間在走，直觀感受「系統還活著」。
        _agoTicker = new System.Timers.Timer(1000) { AutoReset = true };
        _agoTicker.Elapsed += (_, _) =>
        {
            _nowUtc = DateTime.UtcNow;
            _ = InvokeAsync(StateHasChanged);
        };
        _agoTicker.Start();
    }

    private void OnStrategyEvaluated(StrategyEvaluatedUpdate update)
    {
        // 心跳時間戳只追蹤 primary strategy；決策日誌則接收所有策略的事件
        if (_primaryStrategy is not null && update.StrategyId == _primaryStrategy.Id)
        {
            // Domain DTO 是 immutable record — 用 with-expression 同時更新心跳時間與
            // S45 熱轉型後的 Name / StrategyType。下一個 kline tick 內卡片就會反映新名字與模型標籤，
            // 不用依賴重拉 /api/strategies。
            _primaryStrategy = _primaryStrategy with
            {
                LastEvaluatedAtUtc = update.EvaluatedAtUtc,
                Name = update.StrategyName,
                StrategyType = update.StrategyType,
            };
            _heartbeatPulseTick++;
        }
        _nowUtc = DateTime.UtcNow;

        // S44：推入滾動日誌。SignalType 決定色碼分組：
        //   None            → INF 灰
        //   OpenLong/Close* → SIGNAL BUY 亮綠（進/出多）
        //   OpenShort/Close*→ SIGNAL SELL 亮紅
        var (tag, cssClass) = update.SignalType switch
        {
            "OpenLong"   => ("SIGNAL BUY",  "signal-buy"),
            "CloseShort" => ("SIGNAL BUY",  "signal-buy"),
            "OpenShort"  => ("SIGNAL SELL", "signal-sell"),
            "CloseLong"  => ("SIGNAL SELL", "signal-sell"),
            _            => ("INF",          "inf"),
        };
        // INF 時 Note = "No signal" 太吵，改成顯示最後收盤價；SIGNAL 時 Note = 策略 Reason 直接上。
        var displayNote = cssClass == "inf"
            ? $"close={update.LastClosePrice:N2}"
            : update.Note;
        PushLogEntry(new EvaluationEntry(
            TimestampLocal: update.EvaluatedAtUtc.ToLocalTime(),
            Tag: tag,
            CssClass: cssClass,
            StrategyName: update.StrategyName,
            Symbol: update.Symbol,
            Note: displayNote));

        InvokeAsync(StateHasChanged);
    }

    // S45-S48 VCP-Realtime-Sync：Lab 套用完成當下，不等下一拍心跳就把卡片跳轉 —
    // Name / StrategyType / Symbol / Interval / Leverage 全部同步更新，避免 15m / 1h 週期下
    // UI 看起來還停留在舊身分的錯覺。只處理 primary strategy；多卡片版面未來再擴。
    private void OnStrategyMetadataChanged(StrategyMetadataChangedUpdate update)
    {
        if (_primaryStrategy is null || update.StrategyId != _primaryStrategy.Id) return;

        _primaryStrategy = _primaryStrategy with
        {
            Name = update.Name,
            StrategyType = update.StrategyType,
            Symbol = update.Symbol,
            Interval = update.Interval,
            Leverage = update.Leverage,
        };
        _selectedStrategyType = update.StrategyType;
        InvokeAsync(StateHasChanged);
    }

    private void OnStrategyEvaluationFailed(StrategyEvaluationFailedUpdate update)
    {
        _nowUtc = DateTime.UtcNow;

        // S56 T4：風控攔截事件用 [RISK] prefix 區別於策略評估崩潰 —
        // 兩者的顯性化程度不同：評估崩潰是系統壞掉（紅橘），風控攔截是正常保護機制（琥珀金）。
        // 使用者看到琥珀色能立即知道「策略還活著，只是這一筆被風控擋下」，而不是誤判為系統故障。
        var isRiskReject = update.ErrorMessage.StartsWith("[RISK]", StringComparison.Ordinal);
        var tag = isRiskReject ? "RISK" : "ERROR";
        var cssClass = isRiskReject ? "risk-rejected" : "error";
        // Tag 已經標 RISK，Note 內重複 prefix 沒意義 — 去頭
        var note = isRiskReject
            ? update.ErrorMessage["[RISK]".Length..].TrimStart()
            : update.ErrorMessage;

        PushLogEntry(new EvaluationEntry(
            TimestampLocal: update.OccurredAtUtc.ToLocalTime(),
            Tag: tag,
            CssClass: cssClass,
            StrategyName: update.StrategyName,
            Symbol: update.Symbol,
            Note: note));
        InvokeAsync(StateHasChanged);
    }

    private void PushLogEntry(EvaluationEntry entry)
    {
        _evaluationLog.AddFirst(entry);
        while (_evaluationLog.Count > EvaluationLogCapacity)
            _evaluationLog.RemoveLast();
    }

    private void OnPositionPnLTicked(PositionPnLTickUpdate update)
    {
        // FS-V2 T1：UI 鏈路驗證 — 確認 WS → Synchronizer → Broadcaster → Bus → Dashboard
        // 這段 in-process 事件有真的抵達 UI thread。Debug level，正常運行時不噴 log；
        // 查「PnL 死水」時把 log level 拉到 Debug 即可看見每秒 tick。
        var idx = _openPositions.FindIndex(p => p.Id == update.PositionId);
        if (idx < 0)
        {
            Logger.LogDebug(
                "PositionPnLTicked miss: {PositionId} {Symbol} @ {Mark} — 尚未出現在 _openPositions 快照中，丟棄。",
                update.PositionId, update.Symbol, update.CurrentPrice);
            return;
        }

        var old = _openPositions[idx];
        _openPositions[idx] = old with
        {
            CurrentPrice = update.CurrentPrice,
            UnrealizedPnL = update.UnrealizedPnL,
            UnrealizedPnLPercent = update.UnrealizedPnLPercent,
        };

        Logger.LogDebug(
            "PositionPnLTicked hit: {PositionId} {Symbol} mark={Mark} pnl={Pnl} pct={Pct} — InvokeAsync(StateHasChanged) 觸發畫面重繪。",
            update.PositionId, update.Symbol, update.CurrentPrice, update.UnrealizedPnL, update.UnrealizedPnLPercent);

        InvokeAsync(StateHasChanged);
    }

    // 「Ns ago」簡短格式：<60s 顯示秒，<60m 顯示分，其餘顯示時。
    private static string FormatAgo(TimeSpan delta)
    {
        if (delta.TotalSeconds < 0) return "just now";
        if (delta.TotalSeconds < 60) return $"{(int)delta.TotalSeconds}s ago";
        if (delta.TotalMinutes < 60) return $"{(int)delta.TotalMinutes}m ago";
        return $"{(int)delta.TotalHours}h ago";
    }

    private async Task LoadBreakerStatusAsync()
    {
        try
        {
            using var http = CreateClient();
            _breaker = await http.GetFromJsonAsync<BreakerStatusDto>("/api/strategies/breaker");
        }
        catch
        {
            // 熔斷狀態查不到時預設視為未鎖 — UI 不應因為查詢失敗而變成「永久鎖死」
            _breaker = new BreakerStatusDto(false, null, null);
        }
