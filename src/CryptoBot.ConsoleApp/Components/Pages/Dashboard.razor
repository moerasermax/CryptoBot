@page "/"
@using System.Collections.Generic
@using System.Linq
@using System.Net.Http.Json
@using CryptoBot.Application.Common.Interfaces
@using CryptoBot.Application.Realtime
@using CryptoBot.ConsoleApp.Api.Dtos
@using CryptoBot.ConsoleApp.Realtime
@using CryptoBot.ConsoleApp.Services
@using CryptoBot.Domain.Enums
@using CryptoBot.Domain.Repositories
@inject IServiceScopeFactory ScopeFactory
@inject DashboardEventBus Bus
@inject IExchangeCredentialProvider Credentials
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>CryptoBot · Dashboard</PageTitle>

@if (_showKeyModal)
{
    <div class="env-modal-backdrop">
        <div class="env-modal" role="dialog" aria-modal="true">
            <div class="env-modal-header">
                <span class="env-modal-icon">🔑</span>
                <h3>尚未設定 BingX API 金鑰</h3>
            </div>
            <div class="env-modal-body">
                <p class="env-modal-warn-line">
                    系統目前沒有任何啟用中的交易所金鑰。在設定前指揮中心無法查詢餘額或下單。
                </p>
                <ul class="env-modal-bullets">
                    <li>請到 <b>Settings · 金鑰</b> 頁面新增一組 API Key / Secret。</li>
                    <li>金鑰以 SQLite 本地儲存 — <b>切勿</b> 把 cryptobot.db 傳到公開環境。</li>
                    <li>切換 / 刪除會即時重建 SDK client，不需重啟服務。</li>
                </ul>
            </div>
            <div class="env-modal-actions">
                <button type="button" class="env-modal-btn env-modal-btn-cancel" @onclick="DismissKeyModal">
                    稍後再設定
                </button>
                <button type="button" class="env-modal-btn env-modal-btn-danger" @onclick="GoToKeySettings">
                    前往金鑰設定
                </button>
            </div>
        </div>
    </div>
}

<section class="panel">
    <header class="panel-header">
        <h2>策略控制台</h2>
        <span class="panel-sub">S25 · 策略大腦與執行狀態即時切換</span>
    </header>
    @if (_primaryStrategy is null)
    {
        <div class="empty">尚未建立任何策略 — 請先從 seed 或 /lab 新增。</div>
    }
    else
    {
        <div class="control-row">
            <div class="control-cell">
                <label class="control-label">Strategy</label>
                <div class="control-value">
                    <strong>@_primaryStrategy.Name</strong>
                    <span class="panel-sub">@_primaryStrategy.Symbol · @_primaryStrategy.Interval</span>
                </div>
            </div>

            <div class="control-cell">
                <label class="control-label">決策大腦</label>
                <select class="glass-select"
                        disabled="@(_ctrlBusy || _availableTypes.Count == 0)"
                        @bind="_selectedStrategyType"
                        @bind:after="OnStrategyTypeChangedAsync">
                    @foreach (var t in _availableTypes)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>

            <div class="control-cell">
                <label class="control-label">執行狀態</label>
                <label class="toggle-switch">
                    <input type="checkbox"
                           disabled="@_ctrlBusy"
                           checked="@(_primaryStrategy.Status == "Running")"
                           @onchange="OnToggleRunningAsync" />
                    <span class="toggle-slider"></span>
                    <span class="toggle-text @(_primaryStrategy.Status == "Running" ? "pos" : "neg")">
                        @(_primaryStrategy.Status == "Running" ? "Running" : _primaryStrategy.Status)
                    </span>
                </label>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_ctrlInfo))
        {
            <div class="settings-info">@_ctrlInfo</div>
        }
        @if (!string.IsNullOrEmpty(_ctrlError))
        {
            <div class="settings-error">@_ctrlError</div>
        }
    }
</section>

<section class="grid-cards">
    <article class="card">
        <span class="card-label">Total Equity (USDT)</span>
        <span class="card-value @(_stats is null ? "" : _stats.TotalEquity >= 0 ? "pos" : "neg")">
            @FormatMoney(_stats?.TotalEquity)
        </span>
        <span class="card-footnote">Balance + Unrealized</span>
    </article>

    <article class="card">
        <span class="card-label">Today P&amp;L</span>
        <span class="card-value @(_stats is null ? "" : _stats.TodayPnL >= 0 ? "pos" : "neg")">
            @FormatSignedMoney(_stats?.TodayPnL)
        </span>
        <span class="card-footnote">Realized + Unrealized since UTC 00:00</span>
    </article>

    <article class="card">
        <span class="card-label">Active Strategies</span>
        <span class="card-value">
            @(_stats?.ActiveStrategyCount.ToString() ?? "—")
        </span>
        <span class="card-footnote">Status = Running</span>
    </article>
</section>

<section class="panel">
    <header class="panel-header">
        <h2>Active Positions</h2>
        <span class="panel-sub">@(_openPositions.Count) open</span>
    </header>

    @if (_openPositions.Count == 0)
    {
        <div class="empty">No open positions — bot is flat.</div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Symbol</th>
                    <th>Side</th>
                    <th>Qty</th>
                    <th>Entry</th>
                    <th>Mark</th>
                    <th>uPnL</th>
                    <th>uPnL %</th>
                    <th>Opened</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _openPositions)
                {
                    <tr>
                        <td>@p.Symbol</td>
                        <td class="@(p.Side == "Long" ? "pos" : "neg")">@p.Side</td>
                        <td>@p.Quantity.ToString("N4")</td>
                        <td>@p.EntryPrice.ToString("N2")</td>
                        <td>@(p.CurrentPrice?.ToString("N2") ?? "—")</td>
                        <td class="@(p.UnrealizedPnL >= 0 ? "pos" : "neg")">@p.UnrealizedPnL.ToString("N4")</td>
                        <td class="@(p.UnrealizedPnLPercent >= 0 ? "pos" : "neg")">@p.UnrealizedPnLPercent.ToString("N2")%</td>
                        <td>@p.OpenedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="panel">
    <header class="panel-header">
        <h2>Recent Trades</h2>
        <span class="panel-sub">last 10</span>
    </header>

    @if (_recentTrades.Count == 0)
    {
        <div class="empty">No trades yet — waiting for the first signal.</div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Symbol</th>
                    <th>Side</th>
                    <th>Qty</th>
                    <th>Avg Fill</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in _recentTrades)
                {
                    <tr>
                        <td>@t.CreatedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                        <td>@t.Symbol</td>
                        <td class="@(t.Side == "Buy" ? "pos" : "neg")">@t.Side @t.PositionSide</td>
                        <td>@t.Quantity.ToString("N4")</td>
                        <td>@(t.AverageFillPrice?.ToString("N2") ?? "—")</td>
                        <td>@t.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private DashboardStatsUpdate? _stats;
    private List<OpenPositionDto> _openPositions = new();
    private List<RecentTradeDto> _recentTrades = new();

    private Action<DashboardStatsUpdate>? _statsHandler;
    private Action<TradeFilledUpdate>? _tradeHandler;
    private EventHandler<ExchangeCredentialsChangedEventArgs>? _credsHandler;

    // S25 controls
    private StrategyDto? _primaryStrategy;
    private string _selectedStrategyType = string.Empty;
    private List<string> _availableTypes = new();
    private bool _ctrlBusy;
    private string? _ctrlInfo;
    private string? _ctrlError;

    // S24 onboarding
    private bool _showKeyModal;
    private bool _keyModalDismissed;

    private HttpClient CreateClient()
    {
        var http = HttpFactory.CreateClient();
        http.BaseAddress = new Uri(Nav.BaseUri);
        return http;
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshKeyGateAsync();
        _credsHandler = OnCredentialsChanged;
        Credentials.CredentialsChanged += _credsHandler;

        // 1) 首屏快照（不等 2s 心跳）
        await RefreshSnapshotAsync();
        await LoadStrategyControlsAsync();

        // 2) 訂閱即時推播 — 後續只差異更新，不再整包重拉
        _statsHandler = OnStatsUpdate;
        _tradeHandler = OnTradeFilled;
        Bus.StatsUpdated += _statsHandler;
        Bus.TradeFilled += _tradeHandler;
    }

    private async Task RefreshKeyGateAsync()
    {
        try
        {
            var c = await Credentials.GetActiveAsync(ExchangeName.BingX);
            _showKeyModal = !c.IsConfigured && !_keyModalDismissed;
        }
        catch
        {
            _showKeyModal = !_keyModalDismissed;
        }
    }

    private void OnCredentialsChanged(object? sender, ExchangeCredentialsChangedEventArgs e)
    {
        if (e.Exchange != ExchangeName.BingX) return;
        _showKeyModal = !e.Credentials.IsConfigured && !_keyModalDismissed;
        InvokeAsync(StateHasChanged);
    }

    private void DismissKeyModal()
    {
        _keyModalDismissed = true;
        _showKeyModal = false;
    }

    private void GoToKeySettings()
    {
        _keyModalDismissed = true;
        Nav.NavigateTo("/settings/exchanges");
    }

    private async Task LoadStrategyControlsAsync()
    {
        try
        {
            using var http = CreateClient();
            var list = await http.GetFromJsonAsync<List<StrategyDto>>("/api/strategies");
            _primaryStrategy = list?.FirstOrDefault();
            _selectedStrategyType = _primaryStrategy?.StrategyType ?? string.Empty;

            var types = await http.GetFromJsonAsync<List<string>>("/api/strategies/available-types");
            _availableTypes = types ?? new List<string>();
        }
        catch (Exception ex)
        {
            _ctrlError = $"載入策略控制台失敗：{ex.Message}";
        }
    }

    private async Task OnStrategyTypeChangedAsync()
    {
        if (_primaryStrategy is null) return;
        if (string.IsNullOrWhiteSpace(_selectedStrategyType)) return;
        if (_selectedStrategyType == _primaryStrategy.StrategyType) return;

        _ctrlBusy = true; _ctrlError = _ctrlInfo = null;
        try
        {
            using var http = CreateClient();
            var resp = await http.PutAsJsonAsync(
                $"/api/strategies/{_primaryStrategy.Id}/type",
                new ChangeStrategyTypeRequest(_selectedStrategyType));

            if (!resp.IsSuccessStatusCode)
            {
                _ctrlError = $"切換失敗：{resp.StatusCode} {(await resp.Content.ReadAsStringAsync())}";
                _selectedStrategyType = _primaryStrategy.StrategyType; // 回滾
                return;
            }

            var body = await resp.Content.ReadFromJsonAsync<ChangeStrategyTypeResponseDto>();
            _ctrlInfo = body?.Message ?? "已切換決策大腦。";
            await LoadStrategyControlsAsync();
        }
        finally { _ctrlBusy = false; }
    }

    private async Task OnToggleRunningAsync(ChangeEventArgs _)
    {
        if (_primaryStrategy is null) return;

        _ctrlBusy = true; _ctrlError = _ctrlInfo = null;
        try
        {
            using var http = CreateClient();
            var resp = await http.PostAsync($"/api/strategies/{_primaryStrategy.Id}/toggle", null);
            if (!resp.IsSuccessStatusCode)
            {
                _ctrlError = $"狀態切換失敗：{resp.StatusCode} {(await resp.Content.ReadAsStringAsync())}";
                return;
            }

            var body = await resp.Content.ReadFromJsonAsync<ToggleResponseDto>();
            _ctrlInfo = body?.Message ?? "已切換狀態。";
            await LoadStrategyControlsAsync();
        }
        finally { _ctrlBusy = false; }
    }

    private async Task RefreshSnapshotAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var sp = scope.ServiceProvider;

        var statsSvc = sp.GetRequiredService<DashboardStatsService>();
        _stats = await statsSvc.GetAsync();

        var positionRepo = sp.GetRequiredService<IPositionRepository>();
        var openPositions = await positionRepo.GetOpenPositionsAsync();
        _openPositions = openPositions.Select(p => new OpenPositionDto(
            Id: p.Id,
            Symbol: p.Symbol.BingXFormat,
            Side: p.Side.ToString(),
            Quantity: p.Quantity.Value,
            EntryPrice: p.EntryPrice.Value,
            CurrentPrice: p.CurrentPrice?.Value,
            UnrealizedPnL: p.UnrealizedPnL,
            UnrealizedPnLPercent: p.UnrealizedPnLPercent,
            OpenedAt: p.OpenedAt)).ToList();

        var orderRepo = sp.GetRequiredService<IOrderRepository>();
        var orders = await orderRepo.GetRecentAsync(10);
        _recentTrades = orders
            .Select(o => new RecentTradeDto(
                OrderId: o.Id,
                CreatedAt: o.CreatedAt,
                Symbol: o.Symbol.BingXFormat,
                Side: o.Side.ToString(),
                PositionSide: o.PositionSide.ToString(),
                Quantity: o.Quantity.Value,
                AverageFillPrice: o.AverageFillPrice?.Value,
                Status: o.Status.ToString()))
            .ToList();
    }

    private void OnStatsUpdate(DashboardStatsUpdate update)
    {
        _stats = update;
        InvokeAsync(StateHasChanged);
    }

    private void OnTradeFilled(TradeFilledUpdate update)
    {
        // 收到新成交就整包重拉一次（簡單且精準 — 新 Position / 新 Order 都涵蓋）
        _ = InvokeAsync(async () =>
        {
            await RefreshSnapshotAsync();
            StateHasChanged();
        });
    }

    private static string FormatMoney(decimal? v) => v is null ? "—" : v.Value.ToString("N4");
    private static string FormatSignedMoney(decimal? v) =>
        v is null ? "—" : (v.Value >= 0 ? "+" : "") + v.Value.ToString("N4");

    public void Dispose()
    {
        if (_statsHandler is not null) Bus.StatsUpdated -= _statsHandler;
        if (_tradeHandler is not null) Bus.TradeFilled -= _tradeHandler;
        if (_credsHandler is not null) Credentials.CredentialsChanged -= _credsHandler;
    }
}
