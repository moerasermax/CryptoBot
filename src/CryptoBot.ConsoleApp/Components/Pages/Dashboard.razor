    private async Task OnResetBreakerAsync()
    {
        _breakerBusy = true;
        try
        {
            using var http = CreateClient();
            var resp = await http.PostAsync("/api/strategies/breaker/reset", content: null);
            if (resp.IsSuccessStatusCode)
                await LoadBreakerStatusAsync();
        }
        finally { _breakerBusy = false; }
    }

    private void OnKillSwitchClick() => _showKillSwitchConfirm = true;
    private void CancelKillSwitch() => _showKillSwitchConfirm = false;

    private async Task ConfirmKillSwitchAsync()
    {
        _killSwitchBusy = true; _ctrlError = _ctrlInfo = null;
        try
        {
            using var http = CreateClient();
            var resp = await http.PostAsync("/api/strategies/kill-switch", content: null);
            if (!resp.IsSuccessStatusCode)
            {
                _ctrlError = $"Kill switch 失敗：{resp.StatusCode} {(await resp.Content.ReadAsStringAsync())}";
                return;
            }

            var body = await resp.Content.ReadFromJsonAsync<KillSwitchResponseDto>();
            _ctrlInfo = body?.Message ?? "Kill switch executed.";
            await LoadStrategyControlsAsync();
            await RefreshSnapshotAsync();
        }
        finally
        {
            _killSwitchBusy = false;
            _showKillSwitchConfirm = false;
        }
    }

    private async Task RefreshKeyGateAsync()
