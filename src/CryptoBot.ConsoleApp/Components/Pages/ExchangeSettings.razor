@page "/settings/exchanges"
@using System.Net.Http.Json
@using CryptoBot.ConsoleApp.Api
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>CryptoBot · Exchange Keys</PageTitle>

<section class="panel">
    <header class="panel-header">
        <h2>交易所金鑰管理</h2>
        <span class="panel-sub">S24 · SQLite-backed, hot-swappable</span>
    </header>

    <div class="settings-body">
        <p class="settings-hint">
            把 API Key / Secret 存到本機 SQLite — 新增後按「啟用」即時生效，不必重啟。
            同一個交易所只能有一個啟用中的帳號；切換時舊的自動停用。
            <strong>⚠️ 金鑰以明文落地於 <code>cryptobot.db</code>，請確保檔案權限。</strong>
        </p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="settings-error">@_error</div>
        }
        @if (!string.IsNullOrEmpty(_info))
        {
            <div class="settings-info">@_info</div>
        }

        <h3 class="settings-subtitle">新增帳號</h3>
        <div class="glass-form">
            <div class="glass-row">
                <label class="glass-label">Exchange</label>
                <div class="glass-cell" style="flex:2">
                    @* S56 T2 終極方案：改用 GlassDropdown 保證跨瀏覽器深色一致。 *@
                    <GlassDropdown TValue="string"
                                   Value="@_newExchange"
                                   ValueChanged="@(v => { _newExchange = v; StateHasChanged(); })"
                                   Items="@_allExchanges" />
                </div>
            </div>
            <div class="glass-row">
                <label class="glass-label">Account Name</label>
                <div class="glass-cell" style="flex:2">
                    <input type="text" placeholder="例：main / sub-1" @bind="_newAccountName" />
                </div>
            </div>
            <div class="glass-row">
                <label class="glass-label">API Key</label>
                <div class="glass-cell" style="flex:2">
                    <input type="text" @bind="_newApiKey" />
                </div>
            </div>
            <div class="glass-row">
                <label class="glass-label">API Secret</label>
                <div class="glass-cell" style="flex:2">
                    <input type="password" @bind="_newApiSecret" />
                </div>
            </div>
            <div class="glass-row">
                <label class="glass-label">儲存後立即啟用</label>
                <div class="glass-cell" style="flex:2">
                    <input type="checkbox" @bind="_newActivate" />
                </div>
            </div>
        </div>
        <div class="settings-actions">
            <button class="btn-primary" disabled="@_busy" @onclick="AddAccountAsync">新增帳號</button>
        </div>

        <h3 class="settings-subtitle">🤖 Gemini AI 量化導師</h3>
        <p class="settings-hint">
            用於 <code>/lab</code> 的 AI 參數建議。S30-FIX2 起改為「Eco / Pro 雙模式」：
            <strong>Eco</strong>（省錢預設，<code>gemini-2.5-flash</code> + <code>gemini-2.5-flash-lite</code> 備）— 開發 / 反覆按 🪄 試水溫；
            <strong>Pro</strong>（認真模式，<code>gemini-3.1-pro-preview</code> + <code>gemini-2.5-pro</code> 備）— 真的要把建議送進長時間掃描時切過去。
            雙模式皆走 429/503/404 自動退避 + 切備援。取得方式：<a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener">aistudio.google.com/app/apikey</a>。
            金鑰存在本機 SQLite，不寫進 <code>appsettings.json</code>。
        </p>
        <div class="glass-form">
            <div class="glass-row">
                <label class="glass-label">Gemini API Key</label>
                <div class="glass-cell" style="flex:2">
                    @if (_geminiStatus?.IsConfigured == true)
                    {
                        <input type="text" value="@_geminiStatus.KeyPreview" disabled readonly />
                    }
                    else
                    {
                        <input type="password" placeholder="貼上 Google AI Studio 產出的 API Key"
                               @bind="_newGeminiKey" />
                    }
                </div>
            </div>
            <div class="glass-row">
                <label class="glass-label">更新時間</label>
                <div class="glass-cell" style="flex:2">
                    <input type="text" readonly
                           value="@(_geminiStatus?.UpdatedAt is { } u ? u.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "—")" />
                </div>
            </div>
            @* S30-FIX2：Eco / Pro 模式切換 — Eco 為預設，避免開發期一直燒 Pro。 *@
            <div class="glass-row">
                <label class="glass-label">模式</label>
                <div class="glass-cell" style="flex:2">
                    <div class="mode-toggle">
                        <button type="button"
                                class="@ModeButtonClass("Eco")"
                                disabled="@_modeBusy"
                                @onclick='() => ChangeModeAsync("Eco")'>
                            🌱 省錢（Eco · Flash 系）
                        </button>
                        <button type="button"
                                class="@ModeButtonClass("Pro")"
                                disabled="@_modeBusy"
                                @onclick='() => ChangeModeAsync("Pro")'>
                            🚀 認真（Pro · 3.1-pro-preview）
                        </button>
                    </div>
                    <p class="settings-hint" style="margin-top:6px;">
                        當前：<strong>@(_geminiStatus?.Mode ?? "Eco")</strong>
                        — 切換立即生效，下一次 <code>/lab</code> 按 🪄 即用新配對。
                    </p>
                </div>
            </div>
        </div>
        <div class="settings-actions">
            @if (_geminiStatus?.IsConfigured == true)
            {
                <button class="btn-apply" disabled="@_busy" @onclick="EditGeminiKey">更換金鑰</button>
                <button class="btn-danger" disabled="@_busy" @onclick="DeleteGeminiKeyAsync">清除金鑰</button>
            }
            else
            {
                <button class="btn-primary" disabled="@_busy" @onclick="SaveGeminiKeyAsync">儲存金鑰</button>
            }
        </div>

        <h3 class="settings-subtitle">已存帳號</h3>
        @if (_accounts.Count == 0)
        {
            <div class="empty">尚無任何交易所帳號 — 新增上方表單後生效。</div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Exchange</th>
                        <th>Account</th>
                        <th>API Key</th>
                        <th>API Secret</th>
                        <th>Status</th>
                        <th>Updated</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in _accounts)
                    {
                        <tr>
                            <td>@a.Exchange</td>
                            <td>@a.AccountName</td>
                            <td><code>@a.ApiKeyPreview</code></td>
                            <td><code>@a.ApiSecretMask</code></td>
                            <td class="@(a.IsActive ? "pos" : "")">@(a.IsActive ? "ACTIVE" : "—")</td>
                            <td>@a.UpdatedAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                            <td>
                                @if (!a.IsActive)
                                {
                                    <button class="btn-apply" disabled="@_busy" @onclick="@(() => ActivateAsync(a.Id))">啟用</button>
                                }
                                <button class="btn-danger" disabled="@_busy" @onclick="@(() => DeleteAsync(a.Id))">刪除</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>

@code {
    private static readonly string[] _allExchanges =
        Enum.GetNames(typeof(CryptoBot.Domain.Enums.ExchangeName));

    private List<ExchangeAccountDto> _accounts = new();
    private string _newExchange = "BingX";
    private string _newAccountName = "main";
    private string _newApiKey = string.Empty;
    private string _newApiSecret = string.Empty;
    private bool _newActivate = true;
    private bool _busy;
    private string? _error;
    private string? _info;

    // S30：Gemini 金鑰狀態。顯示遮罩預覽，透過 PUT /api/ai/credentials/Gemini 寫入。
    private AiCredentialDto? _geminiStatus;
    private string _newGeminiKey = string.Empty;
    private const string GeminiProvider = "Gemini";

    // S30-FIX2：Eco/Pro 切換期間的 busy 旗標 — 避免快速連按造成競態。
    private bool _modeBusy;

    // S74-D：legacy _traces / _models 狀態 + ReloadTracesAsync / ToggleTracesAsync /
    // FormatAttemptChain / ProbeModelsAsync 方法已隨 /api/ai/{traces, models} endpoints 一併移除。

    private HttpClient CreateClient()
    {
        var http = HttpFactory.CreateClient();
        http.BaseAddress = new Uri(Nav.BaseUri);
        return http;
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        await ReloadGeminiAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            using var http = CreateClient();
            var list = await http.GetFromJsonAsync<List<ExchangeAccountDto>>("/api/exchange-accounts");
            _accounts = list ?? new();
        }
        catch (Exception ex)
        {
            _error = $"載入失敗：{ex.Message}";
        }
    }

    private async Task ReloadGeminiAsync()
    {
        try
        {
            using var http = CreateClient();
            _geminiStatus = await http.GetFromJsonAsync<AiCredentialDto>(
                $"/api/ai/credentials/{GeminiProvider}");
        }
        catch (Exception ex)
        {
            _error = $"Gemini 金鑰狀態載入失敗：{ex.Message}";
        }
    }

    private void EditGeminiKey()
    {
        // 切到「輸入新金鑰」模式 — 強制本地狀態為未配置，讓輸入框重現。Mode 保留現值。
        var mode = _geminiStatus?.Mode ?? "Eco";
        _geminiStatus = new AiCredentialDto(GeminiProvider, IsConfigured: false, KeyPreview: string.Empty, Mode: mode, UpdatedAt: null);
        _newGeminiKey = string.Empty;
    }

    private string ModeButtonClass(string target)
    {
        var current = _geminiStatus?.Mode ?? "Eco";
        return string.Equals(current, target, StringComparison.OrdinalIgnoreCase)
            ? "btn-apply mode-active"
            : "btn-inline";
    }

    private async Task ChangeModeAsync(string mode)
    {
        if (string.Equals(_geminiStatus?.Mode, mode, StringComparison.OrdinalIgnoreCase)) return;
        _error = _info = null;
        _modeBusy = true;
        try
        {
            using var http = CreateClient();
            var resp = await http.PutAsJsonAsync(
                $"/api/ai/credentials/{GeminiProvider}/mode",
                new UpdateAiModeRequest(mode));
            if (!resp.IsSuccessStatusCode)
            {
                _error = $"模式切換失敗：{resp.StatusCode} {(await resp.Content.ReadAsStringAsync())}";
                return;
            }
            _info = $"✓ 已切到 {mode} 模式 — 下一次 AI 請求即用新配對。";
            await ReloadGeminiAsync();
        }
        finally { _modeBusy = false; }
    }

    private async Task SaveGeminiKeyAsync()
    {
        _error = _info = null;
        if (string.IsNullOrWhiteSpace(_newGeminiKey))
        {
            _error = "Gemini API Key 不能為空。";
            return;
        }
        _busy = true;
        try
        {
            using var http = CreateClient();
            var resp = await http.PutAsJsonAsync(
                $"/api/ai/credentials/{GeminiProvider}",
                new UpsertAiCredentialRequest(_newGeminiKey.Trim()));
            if (!resp.IsSuccessStatusCode)
            {
                _error = $"儲存失敗：{resp.StatusCode} {(await resp.Content.ReadAsStringAsync())}";
                return;
            }
            _info = "✓ Gemini 金鑰已儲存 — 下一次 AI 請求即生效。";
            _newGeminiKey = string.Empty;
            await ReloadGeminiAsync();
        }
        finally { _busy = false; }
    }

    private async Task DeleteGeminiKeyAsync()
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "確定清除 Gemini 金鑰？AI 建議功能將停用。");
        if (!ok) return;

        _error = _info = null; _busy = true;
        try
        {
            using var http = CreateClient();
            var resp = await http.DeleteAsync($"/api/ai/credentials/{GeminiProvider}");
            if (!resp.IsSuccessStatusCode)
            {
                _error = $"清除失敗：{resp.StatusCode}";
                return;
            }
            _info = "Gemini 金鑰已清除。";
            await ReloadGeminiAsync();
        }
        finally { _busy = false; }
    }

    private async Task AddAccountAsync()
    {
        _error = _info = null;

        if (string.IsNullOrWhiteSpace(_newApiKey) || string.IsNullOrWhiteSpace(_newApiSecret))
        {
            _error = "API Key / Secret 不能為空。";
            return;
        }

        _busy = true;
        try
        {
            var req = new CreateExchangeAccountRequest(
                Exchange: _newExchange,
                AccountName: _newAccountName,
                ApiKey: _newApiKey,
                ApiSecret: _newApiSecret,
                Activate: _newActivate);

            using var http = CreateClient();
            var resp = await http.PostAsJsonAsync("/api/exchange-accounts", req);
            if (!resp.IsSuccessStatusCode)
            {
                _error = $"新增失敗：{resp.StatusCode} {(await resp.Content.ReadAsStringAsync())}";
                return;
            }

            _info = _newActivate ? "已新增並啟用 — SDK client 已重建。" : "已新增（未啟用）。";
            _newApiKey = _newApiSecret = string.Empty;
            _newAccountName = "main";
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private async Task ActivateAsync(Guid id)
    {
        _error = _info = null; _busy = true;
        try
        {
            using var http = CreateClient();
            var resp = await http.PostAsync($"/api/exchange-accounts/{id}/activate", null);
            if (!resp.IsSuccessStatusCode)
            {
                _error = $"啟用失敗：{resp.StatusCode} {(await resp.Content.ReadAsStringAsync())}";
                return;
            }
            _info = "已切換啟用帳號 — SDK client 已重建。";
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(Guid id)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "確定刪除這筆帳號？若為 ACTIVE 將使該交易所變為未配置。");
        if (!ok) return;

        _error = _info = null; _busy = true;
        try
        {
            using var http = CreateClient();
            var resp = await http.DeleteAsync($"/api/exchange-accounts/{id}");
            if (!resp.IsSuccessStatusCode)
            {
                _error = $"刪除失敗：{resp.StatusCode} {(await resp.Content.ReadAsStringAsync())}";
                return;
            }
            _info = "已刪除。";
            await ReloadAsync();
        }
        finally { _busy = false; }
    }
}
