@*
    Blazor Web App（.NET 8）根元件。
    <HeadOutlet> 會把各頁面的 <PageTitle> 塞進 <head>。
    <script src="_framework/blazor.web.js"> 是 server rendermode 必要的腳本。
*@
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>CryptoBot — 指揮中心</title>
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    @* S26 T2：ApexCharts CDN + 本地 interop wrapper。
       CDN 先載入，chart_interop.js 才能引用全域 ApexCharts。 *@
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="chart_interop.js"></script>
</body>
</html>
