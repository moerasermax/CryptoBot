@using System.Net
@using CryptoBot.Application.Ai
@using CryptoBot.Application.Realtime
@using CryptoBot.ConsoleApp.Realtime
@inject IGlobalAiChatService Chat
@inject DashboardEventBus EventBus
@implements IAsyncDisposable

@*
    S74-C：全域常駐 AI 對話 sidebar — 跨所有頁面（Dashboard / Lab / Settings / Admin）顯示。
    對話歷史與 Blazor circuit（Scoped）同生死；點 🪄 fab 開合面板，AI 回應含 JSON payload 時
    顯示「套用至實驗室」按鈕透過 DashboardEventBus 廣播。

    樣式以 .gais-* prefix 自包，不依賴 app.css；避免污染全域命名空間。
*@

<div class="gais-root @(_open ? "gais-open" : string.Empty)">
    <button type="button"
            class="gais-fab"
            @onclick="Toggle"
            title="@(_open ? "收起 Sidekick" : "展開 CryptoBot Sidekick")">
        @(_open ? "✕" : "🪄")
    </button>

    @if (_open)
    {
        <div class="gais-panel" role="dialog" aria-label="CryptoBot Sidekick">
            <header class="gais-header">
                <h3>CryptoBot Sidekick</h3>
                <div class="gais-header-actions">
                    <button type="button"
                            class="gais-btn-secondary"
                            @onclick="ClearAsync"
                            disabled="@_busy"
                            title="清空本機對話歷史（gemini session 仍在）">
                        🗑 清空
                    </button>
                </div>
            </header>

            <div class="gais-history" @ref="_historyRef">
                @if (Chat.History.Count == 0)
                {
                    <div class="gais-empty">
                        提示：跟我聊聊當前行情，或請我幫你設計策略網格參數。
                        當回應含 JSON 參數塊時會出現「🪄 套用至實驗室」按鈕。
                    </div>
                }
                @foreach (var msg in Chat.History)
                {
                    <div class="gais-msg gais-msg-@msg.Role">
                        <div class="gais-msg-meta">
                            <span class="gais-msg-role">@RoleLabel(msg.Role)</span>
                            <span class="gais-msg-time">@msg.At.ToLocalTime().ToString("HH:mm:ss")</span>
                        </div>
                        <div class="gais-msg-body">@RenderBody(msg.Text)</div>
                        @if (msg.HasJson && msg.Payload is not null)
                        {
                            <button type="button"
                                    class="gais-apply-btn"
                                    @onclick="() => ApplyAsync(msg.Payload!)"
                                    title="送一份結構化參數 payload 至 /lab — BacktestLab 訂閱者會比對策略 key 後套表單">
                                🪄 套用參數至實驗室（@msg.Payload!.Parameters.Count 維）
                            </button>
                        }
                    </div>
                }
                @if (_busy)
                {
                    <div class="gais-msg gais-msg-system">
                        <div class="gais-msg-body">AI 思考中…（gemini -p 單發呼叫）</div>
                    </div>
                }
            </div>

            <footer class="gais-footer">
                <textarea class="gais-input"
                          @bind="_input"
                          @bind:event="oninput"
                          @onkeydown="OnInputKeyDownAsync"
                          disabled="@_busy"
                          rows="2"
                          placeholder="輸入訊息，Enter 送出，Shift+Enter 換行…"></textarea>
                <button type="button"
                        class="gais-btn-send"
                        @onclick="SendAsync"
                        disabled="@(_busy || string.IsNullOrWhiteSpace(_input))">
                    送出
                </button>
            </footer>
        </div>
    }
</div>

<style>
    .gais-root { position: fixed; right: 1rem; bottom: 1rem; z-index: 9999; font-family: inherit; }

    .gais-fab {
        width: 3.25rem; height: 3.25rem; border-radius: 50%;
        background: linear-gradient(135deg, #7c3aed, #2563eb);
        color: #fff; font-size: 1.5rem; border: none; cursor: pointer;
        box-shadow: 0 6px 16px rgba(0,0,0,.35), 0 0 0 2px rgba(255,255,255,.08) inset;
        transition: transform .15s ease, box-shadow .15s ease;
    }
    .gais-fab:hover { transform: translateY(-1px); box-shadow: 0 8px 20px rgba(0,0,0,.45); }
    .gais-open .gais-fab { background: linear-gradient(135deg, #475569, #1e293b); }

    .gais-panel {
        position: absolute; right: 0; bottom: 4rem;
        width: min(420px, calc(100vw - 2rem)); height: min(580px, calc(100vh - 6rem));
        display: flex; flex-direction: column;
        background: rgba(15, 23, 42, .96); color: #e2e8f0;
        border: 1px solid rgba(148, 163, 184, .25); border-radius: 12px;
        box-shadow: 0 20px 50px rgba(0,0,0,.55);
        backdrop-filter: blur(8px);
        overflow: hidden;
    }

    .gais-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: .75rem 1rem; border-bottom: 1px solid rgba(148, 163, 184, .2);
        background: rgba(30, 41, 59, .65);
    }
    .gais-header h3 { margin: 0; font-size: 1rem; font-weight: 600; letter-spacing: .02em; }
    .gais-header-actions { display: flex; gap: .5rem; }

    .gais-btn-secondary {
        background: rgba(71, 85, 105, .5); color: #e2e8f0;
        border: 1px solid rgba(148, 163, 184, .25); border-radius: 6px;
        padding: .25rem .6rem; font-size: .8rem; cursor: pointer;
    }
    .gais-btn-secondary:disabled { opacity: .4; cursor: not-allowed; }

    .gais-history {
        flex: 1; overflow-y: auto; padding: .75rem 1rem;
        display: flex; flex-direction: column; gap: .75rem;
    }
    .gais-empty {
        color: #94a3b8; font-size: .85rem; line-height: 1.5;
        padding: 1rem; border: 1px dashed rgba(148, 163, 184, .3); border-radius: 8px;
    }

    .gais-msg { display: flex; flex-direction: column; gap: .25rem; }
    .gais-msg-meta { font-size: .7rem; color: #94a3b8; display: flex; gap: .5rem; }
    .gais-msg-role { font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
    .gais-msg-body {
        padding: .5rem .75rem; border-radius: 8px; font-size: .88rem; line-height: 1.5;
        white-space: pre-wrap; word-break: break-word;
    }
    .gais-msg-user .gais-msg-body { background: rgba(37, 99, 235, .22); border: 1px solid rgba(96, 165, 250, .3); }
    .gais-msg-ai .gais-msg-body { background: rgba(71, 85, 105, .28); border: 1px solid rgba(148, 163, 184, .2); }
    .gais-msg-system .gais-msg-body { background: rgba(124, 58, 237, .18); border: 1px solid rgba(167, 139, 250, .3); color: #c4b5fd; font-style: italic; }

    .gais-apply-btn {
        margin-top: .25rem; align-self: flex-start;
        background: linear-gradient(135deg, #16a34a, #15803d);
        color: #fff; border: none; border-radius: 6px;
        padding: .35rem .75rem; font-size: .82rem; font-weight: 600;
        cursor: pointer; box-shadow: 0 2px 6px rgba(0,0,0,.3);
    }
    .gais-apply-btn:hover { filter: brightness(1.1); }

    .gais-footer {
        display: flex; gap: .5rem; padding: .75rem 1rem;
        border-top: 1px solid rgba(148, 163, 184, .2);
        background: rgba(30, 41, 59, .5);
    }
    .gais-input {
        flex: 1; resize: none;
        background: rgba(15, 23, 42, .85); color: #e2e8f0;
        border: 1px solid rgba(148, 163, 184, .3); border-radius: 6px;
        padding: .5rem; font-size: .88rem; line-height: 1.4;
        font-family: inherit;
    }
    .gais-input:focus { outline: 2px solid rgba(96, 165, 250, .5); outline-offset: 0; }
    .gais-input:disabled { opacity: .5; }

    .gais-btn-send {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: #fff; border: none; border-radius: 6px;
        padding: .5rem 1rem; font-size: .88rem; font-weight: 600; cursor: pointer;
        align-self: flex-end;
    }
    .gais-btn-send:disabled { opacity: .4; cursor: not-allowed; }
    .gais-btn-send:not(:disabled):hover { filter: brightness(1.1); }
</style>

@code {
    private bool _open;
    private bool _busy;
    private string _input = string.Empty;
    private ElementReference _historyRef;

    protected override void OnInitialized()
    {
        Chat.HistoryChanged += OnHistoryChanged;
    }

    private void OnHistoryChanged() => _ = InvokeAsync(StateHasChanged);

    private void Toggle() => _open = !_open;

    private async Task OnInputKeyDownAsync(KeyboardEventArgs e)
    {
        // Enter 送出；Shift+Enter 換行（textarea 預設行為，不攔截）
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendAsync();
        }
    }

    private async Task SendAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_input)) return;
        var text = _input.Trim();
        _input = string.Empty;
        _busy = true;
        StateHasChanged();
        try
        {
            // GlobalAiChatService 合約：永不拋；任何失敗已 append 至 History 為 ai 訊息。
            await Chat.SendAsync(text);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task ClearAsync()
    {
        if (_busy) return;
        await Chat.ClearAsync();
    }

    private void ApplyAsync(ApplyAiParametersUpdate payload)
    {
        // 廣播給 DashboardEventBus — BacktestLab.razor 訂閱者會比對策略 key 後決定套用 / toast 提示。
        EventBus.RaiseApplyAiParameters(payload);
    }

    private static string RoleLabel(string role) => role switch
    {
        "user" => "你",
        "ai"   => "AI",
        _      => role,
    };

    // 純文字呈現（含換行保留）— Razor 預設對字串會 HTML-escape，故只需把 \n 轉 <br />。
    private static MarkupString RenderBody(string text)
    {
        var encoded = WebUtility.HtmlEncode(text ?? string.Empty);
        return new MarkupString(encoded.Replace("\n", "<br />"));
    }

    public ValueTask DisposeAsync()
    {
        Chat.HistoryChanged -= OnHistoryChanged;
        return ValueTask.CompletedTask;
    }
}
